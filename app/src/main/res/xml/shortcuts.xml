<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <capability
        android:name="custom.actions.intent.ASK_DEEPSEEK_HARNESS"
        app:queryPatterns="@array/ask_deepseek_harness_query_patterns">
        <intent
            android:action="ai.deepseek.harness.action.ASK_DEEPSEEK_HARNESS"
            android:targetPackage="ai.deepseek.harness"
            android:targetClass="ai.deepseek.harness.MainActivity">
            <parameter
                android:name="prompt"
                android:key="prompt"
                android:mimeType="https://schema.org/Text"
                android:required="true" />
        </intent>
    </capability>
</shortcuts>
