<?xml version="1.0" encoding="utf-8"?>
<!-- 与 backup_rules.xml 同理：allowBackup=false 时本规则为冗余防线；放开前应改为白名单语义。 -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
